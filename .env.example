# No API keys are needed to RUN the game: all NASA data is pre-extracted into the project.
#
# Optional, only for the offline NASA DONKI sync (npm run sync:donki).
# Put your own key in .env.local (git-ignored), never in this file. Get one free at https://api.nasa.gov/
# Without it the sync falls back to the public DEMO_KEY (low rate limits).
NASA_API_KEY=
